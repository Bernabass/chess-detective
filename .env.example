# Copy to .env and fill in your local PostgreSQL username and password.
# If the password contains special characters (@ : / ? # % etc.), URL-encode them (e.g. @ -> %40).
# Real environment variables take priority over values in this file.

# Development database
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/retrograde?sslmode=disable

# Used only by integration tests (pnpm test:api)
TEST_DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/retrograde_test?sslmode=disable

# Using the optional Docker database (pnpm db:up) instead? Use these two lines:
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/retrograde?sslmode=disable
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/retrograde_test?sslmode=disable

# Address and port the Go API listens on. The Vite dev server forwards /api here.
# 127.0.0.1 keeps it private to this computer (and avoids Windows firewall prompts);
# a container or server sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8080

# Public address of the web app (redirects, origin checks, share links).
BASE_URL=http://localhost:5173

# debug, info, warn or error
LOG_LEVEL=info

# The day of daily puzzle #1 (UTC). Puzzle number = days since LAUNCH_DATE + 1.
# `pnpm seed` adds this line for you (14 days before today) if it's missing, so there are past
# puzzles to try the archive with. Defaults to 2026-11-01 when unset.
# LAUNCH_DATE=2026-11-01

# Mark the session cookie Secure (HTTPS only). Keep false for http://localhost; true in production.
COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For is trusted for the client IP (rate limits), as IPs or
# CIDRs separated by commas. Empty: use the connection's address.
TRUSTED_PROXIES=

# Sign in with Lichess. The defaults are right for development and production: Lichess needs no
# registration, and the client id defaults to BASE_URL's host (e.g. localhost:5173). The tests
# point LICHESS_BASE_URL at a fake Lichess.
# LICHESS_BASE_URL=https://lichess.org
# LICHESS_CLIENT_ID=retrograde.example

# Multiplies every rate limit. Keep 1: only the end-to-end tests raise it, and the API logs a
# warning at startup whenever it isn't 1.
# RATE_LIMIT_SCALE=1
