# Copy to .env and fill in your local PostgreSQL username and password.
# If the password contains special characters (@ : / ? # % etc.), URL-encode them (e.g. @ -> %40).
# Real environment variables take priority over values in this file.

# Development database
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/retrograde?sslmode=disable

# Used only by integration tests (pnpm test:api)
TEST_DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/retrograde_test?sslmode=disable

# Using the optional Docker database (pnpm db:up) instead? Use these two lines:
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/retrograde?sslmode=disable
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/retrograde_test?sslmode=disable

# Address and port the Go API listens on. The Vite dev server forwards /api here.
# 127.0.0.1 keeps it private to this computer (and avoids Windows firewall prompts);
# a container or server sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8080

# Public address of the web app (redirects, origin checks, share links).
BASE_URL=http://localhost:5173

# debug, info, warn or error
LOG_LEVEL=info
