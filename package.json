{
  "name": "retrograde",
  "version": "0.0.0",
  "private": true,
  "description": "Chess detective puzzles built on retrograde analysis",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"go -C services/api run ./cmd/retrograde serve\" \"pnpm --filter @retrograde/web dev\"",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:go && pnpm run test:hooks",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:go": "node scripts/check-go.mjs",
    "test:hooks": "node scripts/test-commit-msg-hook.mjs",
    "test:api": "go -C services/api test -tags integration ./...",
    "gen": "node scripts/gen.mjs",
    "db:migrate": "go -C services/api run ./cmd/retrograde migrate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "build": "pnpm --filter @retrograde/web build && go -C services/api build -o bin/ ./cmd/retrograde"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
