{
  "name": "@retrograde/engine",
  "version": "0.4.0",
  "private": true,
  "description": "Chess and retrograde-analysis engine",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.json",
    "test": "vitest run --coverage --exclude \"test/**/*properties*\" && vitest run properties",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "perft": "tsx bench/perft.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "bench": "tsx bench/solver.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
